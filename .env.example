# Website works without an OpenAI key. Never share your private .env.
PORT=4173
HOST=127.0.0.1
NODE_ENV=development
# Blank uses the local request origin; Render uses RENDER_EXTERNAL_URL automatically.
# For a custom HTTPS domain, set its exact origin here (no path).
APP_ORIGIN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set TRUST_PROXY=1 only behind your trusted HTTPS reverse proxy.
TRUST_PROXY=0
# Local default: ./runtime. On Render with a paid disk mounted at /var/data:
# DATA_DIR=/var/data/rahat
DOCTOR_EMAILS=doctor-demo@example.com
STAFF_EMAILS=staff-demo@example.com
# Local judges demo only: seeds fictional accounts and queue. Ignored in production.
DEMO_SEED=1
